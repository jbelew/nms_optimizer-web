{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"entry": [
		"index.html!",
		"scripts/**/*.{js,mjs,cjs}!",
		".storybook/**/*.{ts,tsx,js}",
		"src/**/*.stories.{ts,tsx}",
		"src/**/*.test.{ts,tsx}",
		"e2e-tests/**/*.{ts,js}",
		"functions/**/*.{ts,js}",
		"src/utils/system/sentryMock.ts"
	],
	"project": [
		"src/**/*.{ts,tsx,js,jsx}!",
		"!src/test/**",
		"!src/**/*.test.{ts,tsx}",
		"!src/**/*.stories.{ts,tsx}",
		"scripts/**/*.{js,mjs,cjs}!",
		"shared/**/*.{ts,js}"
	],
	"ignore": ["typedoc.json"],
	"ignoreDependencies": ["@semantic-release/github"]
}
